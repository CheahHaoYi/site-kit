---
import Layout from '../components/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Table from '../components/Table.astro';
import Callout from '../components/Callout.astro';
import Tag from '../components/Tag.astro';
import Badge from '../components/Badge.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Mermaid from '../components/Mermaid.astro';

const breadcrumbsData = [

  { label: 'Site-Kit', href: '/' },
  { label: 'Aesthetic Benchmark Testbed' },
];

const sampleSubnetHeaders = ['VLAN ID', 'Subnet CIDR', 'Security Zone', 'Default Gateway', 'Inspection Level'];
const sampleSubnetRows = [
  ['VLAN 10', '10.10.10.0/24', 'Internal Core', '10.10.10.1', 'L3/L4 State Track'],
  ['VLAN 20', '10.10.20.0/24', 'AI Inference DMZ', '10.10.20.1', 'L7 mTLS + WAF'],
  ['VLAN 30', '10.10.30.0/24', 'Management Out-of-Band', '10.10.30.1', 'Zero Trust IAM'],
  ['VLAN 99', '192.168.99.0/28', 'Telemetry & SIEM Ingest', '192.168.99.1', 'Packet Mirror / Tap'],
];

const aiGuardrailCode = `import re
from typing import Dict, Any, Optional

class TelemetryGuardrail:
    """
    Evaluates LLM input/output tokens against prompt injection heuristics
    and lateral traversal signatures.
    """
    def __init__(self, sensitivity: float = 0.95):
        self.sensitivity = sensitivity
        self.denylist = [
            r"ignore previous instructions",
            r"system prompt override",
            r"__import__\\s*\\(",
        ]

    def inspect(self, token_payload: str) -> bool:
        for pattern in self.denylist:
            if re.search(pattern, token_payload, re.IGNORECASE):
                return False  # Quarantine & Alert SOC
        return True`;
---

<Layout
  title="Material 3 & Apple HIG Aesthetic Benchmark"
  description="Comprehensive benchmark comparing Apple Human Interface Guidelines and Google Material Design 3 design tokens. Light mode default with dark mode alternative."
  breadcrumbs={breadcrumbsData}
>
  <div class="container page-wrapper">
    <!-- Header Hero -->
    <header class="demo-hero">
      <div class="eyebrow-cluster">
        <Badge pill={true} iosColor="purple" pulse={true}>DESIGN BENCHMARK TESTBED</Badge>
        <Tag pill={true} variant="accent">Light Mode Default</Tag>
        <Tag pill={true} variant="cert">Dark Mode Alternative</Tag>
        <Tag pill={true} variant="outline">Key Color: Purple #7C3AED</Tag>
      </div>

      <h1 class="demo-title">
        Google Material 3 &amp; Apple HIG Aesthetic Benchmark
      </h1>
      
      <p class="demo-lead">
        Proof-of-concept visual testbed demonstrating the synthesis of <strong>Apple Human Interface Guidelines</strong> 
        (San Francisco hierarchy, translucent frosted glass, native iOS colors, spring physics) and 
        <strong>Google Material Design 3</strong> (dynamic purple tonal containers, surface elevations, pill geometry).
      </p>

      <div class="theme-switch-showcase">
        <span class="theme-switch-label">Interactive Theme Switcher:</span>
        <ThemeToggle size="md" />
        <span class="theme-switch-hint">Synchronized across all components with zero layout shift</span>
      </div>
    </header>

    <!-- Comparison Matrix: Material 3 vs Apple HIG -->
    <section class="benchmark-grid">
      <!-- Column 1: Google Material 3 Principles -->
      <div class="benchmark-column m3-column">
        <div class="framework-header">
          <Badge pill={true} iosColor="indigo">GOOGLE MATERIAL DESIGN 3</Badge>
          <h2 class="framework-title">Dynamic Tonal Palettes &amp; Surface Elevations</h2>
          <p class="framework-desc">
            Expressive purple tonal containers (`--color-bg-surface-container`), high-contrast state layers, 
            and structured semantic roles for data density.
          </p>
        </div>

        <div class="column-cards-stack">
          <!-- M3 Tonal Card Example -->
          <Card
            variant="tonal"
            doubleBezel={true}
            title="M3 Tonal Container: Telemetry Ingress"
            description="Tonal surface containers dynamically adapt to light/dark themes while maintaining strict WCAG AA contrast."
            badge="Level 1 Container"
            badgeVariant="accent"
            date="Active"
            tags={['Tonal Elevation', 'Key Color Seed', 'WCAG AAA']}
          >
            <div class="tonal-demo-swatches">
              <div class="m3-mini-chip" style="background: var(--color-accent-primary); color: #fff;">Primary #7C3AED</div>
              <div class="m3-mini-chip" style="background: var(--color-accent-subtle); color: var(--color-accent-on-container);">Container #F3E8FF</div>
              <div class="m3-mini-chip" style="background: var(--color-bg-surface-container); color: var(--color-text-primary);">Surface Level 1</div>
            </div>
          </Card>

          <Card
            variant="default"
            doubleBezel={true}
            title="M3 Pill Controls &amp; State Layers"
            description="Tactile state feedback on hover, focus-visible, and active interactions."
            badge="State Layers"
            badgeVariant="default"
          >
            <div class="m3-buttons-demo">
              <Button variant="primary" pill={true} size="md">
                <span>Filled Primary</span>
                <span class="btn-icon-wrapper">&rarr;</span>
              </Button>
              <Button variant="secondary" pill={true} size="md">
                <span>Tonal Container</span>
              </Button>
              <Button variant="outline" pill={true} size="md">
                <span>Outlined</span>
              </Button>
            </div>
          </Card>

          <Callout variant="info" title="M3 Dynamic Theming Principle">
            Tonal palettes are mathematically derived from the primary key color (Purple 600 `#7c3aed`), generating 
            harmonious container tints and high-contrast typography across both light and dark baselines.
          </Callout>
        </div>
      </div>

      <!-- Column 2: Apple Human Interface Guidelines (HIG) Principles -->
      <div class="benchmark-column apple-column">
        <div class="framework-header">
          <Badge pill={true} iosColor="purple">APPLE HUMAN INTERFACE GUIDELINES</Badge>
          <h2 class="framework-title">Translucent Glass, iOS Colors &amp; Spring Motion</h2>
          <p class="framework-desc">
            Luminous frosted glass (`backdrop-filter: blur(20px)`), top specular rim highlights, 
            concentric squircle curves, and tactile spring physics.
          </p>
        </div>

        <div class="column-cards-stack">
          <!-- Apple Glass Card Example -->
          <Card
            variant="glass"
            doubleBezel={true}
            title="Apple HIG Frosted Glass Material"
            description="Translucent backdrop blur with specular top rim highlight, reflecting ambient container depth."
            badge="Vibrancy Glass"
            badgeVariant="cert"
            date="Hardware Enclosure"
            tags={['Blur 20px', 'Specular Rim', 'Concentric Curvature']}
          >
            <div class="apple-ios-chips-demo">
              <Badge pill={true} iosColor="purple">iOS Purple</Badge>
              <Badge pill={true} iosColor="indigo">iOS Indigo</Badge>
              <Badge pill={true} iosColor="blue">iOS Blue</Badge>
              <Badge pill={true} iosColor="mint">iOS Mint</Badge>
              <Badge pill={true} iosColor="green">iOS Green</Badge>
              <Badge pill={true} iosColor="orange">iOS Orange</Badge>
              <Badge pill={true} iosColor="pink">iOS Pink</Badge>
            </div>
          </Card>

          <Card
            variant="glass"
            doubleBezel={true}
            title="Apple Fluid Spring Choreography"
            description="Transitions use custom spring-damped curves (`cubic-bezier(0.32, 0.72, 0, 1)`)."
            badge="Spring Physics"
            badgeVariant="accent"
          >
            <div class="apple-motion-demo">
              <Button variant="primary" pill={true} size="md">
                <span>Hold to Press</span>
                <span class="btn-icon-wrapper">&uarr;</span>
              </Button>
              <Tag pill={true} interactive={true} iosColor="purple">Interactive Spring Pill</Tag>
            </div>
          </Card>

          <Callout variant="tip" title="Apple HIG Doppelrand (Double-Bezel) Architecture">
            Double-bezel cards feature an outer translucent shell with concentric padding, housing an inner core 
            with specular rim lighting reminiscent of precision Apple hardware.
          </Callout>
        </div>
      </div>
    </section>

    <!-- Synthesis Section: Real-World Technical Showcase -->
    <section class="synthesis-section">
      <div class="framework-header">
        <Badge pill={true} iosColor="mint">UNIFIED SYSTEM SYNTHESIS</Badge>
        <h2 class="framework-title">Multi-Repo Technical Portfolio Application</h2>
        <p class="framework-desc">
          How `@cheahhaoyi/site-kit` harmonizes both design frameworks to display complex networking topologies, 
          AI security code, and certification knowledge bases.
        </p>
      </div>

      <div class="synthesis-content-grid">
        <div>
          <CodeBlock
            code={aiGuardrailCode}
            lang="python"
            filename="telemetry_guardrail.py"
            showLineNumbers={true}
          />
        </div>

        <div>
          <Table
            headers={sampleSubnetHeaders}
            rows={sampleSubnetRows}
            caption="Zero Trust Subnet Architecture (Enterprise Multi-VLAN Topology)"
            striped={true}
          />
        </div>
      </div>
    </section>

    <!-- Interactive Diagram & Mindmap Showcase -->
    <section class="stack-lg">
      <div class="framework-header">
        <Badge pill={true} iosColor="purple">INTERACTIVE TOPOLOGY &amp; MINDMAP</Badge>
        <h2 class="framework-title">Interactive Pan, Zoom &amp; Fullscreen Lightbox</h2>
        <p class="framework-desc">
          High-performance vector architecture viewer with draggable canvas, mouse wheel / pinch zoom, 
          100% reset, copy source code, and full-resolution lightbox expansion.
        </p>
      </div>

      <Mermaid
        title="CISSP CURRICULUM ARCHITECTURE"
        subtitle="Interactive Domain Mindmap & Core Knowledge Branches"
        code={`mindmap
  root((CISSP Domains))
    Domain 1: Security & Risk
      Security Governance
      Due Care & Diligence
      Ethics & Policies hierarchies
      Risk Assessment
    Domain 2: Asset Security
      Classification & Ownership
      Privacy & Retention
      Data Lifecycle Controls
    Domain 3: Security Architecture
      TCB & Cryptography
      Zero Trust Models
      Cloud & Evaluation Criteria
    Domain 4: Network Security
      OSI & TCP/IP Stack
      BGP & Routing Security
      Microsegmentation & WAF
    Domain 5: Identity & Access
      Authentication & MFA
      SSO & SAML/OIDC Federation
      RBAC & ABAC Access Controls`}
      />
    </section>
  </div>
</Layout>

<script is:inline type="module">
  async function loadMermaid() {
    try {
      const mod = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
      return mod.default;
    } catch (e) {
      console.error('Failed to load Mermaid module:', e);
      return null;
    }
  }

  function getMermaidConfig(isDark) {
    return {
      startOnLoad: false,
      securityLevel: 'loose',
      theme: 'base',
      fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "Geist", "Inter", sans-serif',
      themeVariables: isDark
        ? {
            darkMode: true,
            fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "Geist", "Inter", sans-serif',
            primaryColor: '#201836',
            primaryTextColor: '#ede9fe',
            primaryBorderColor: '#a78bfa',
            lineColor: '#a78bfa',
            secondaryColor: '#161026',
            secondaryTextColor: '#ddd6fe',
            secondaryBorderColor: '#8b5cf6',
            tertiaryColor: '#100c1c',
            tertiaryTextColor: '#c4b5fd',
            tertiaryBorderColor: '#7c3aed',
            mainBkg: '#141021',
            nodeBorder: '#a78bfa',
            nodeTextColor: '#f3effc',
            clusterBkg: '#191428',
            clusterBorder: '#6d28d9',
            titleColor: '#f3effc',
            edgeLabelBackground: '#1e1830',
          }
        : {
            darkMode: false,
            fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "Geist", "Inter", sans-serif',
            primaryColor: '#f3e8ff',
            primaryTextColor: '#120e24',
            primaryBorderColor: '#7c3aed',
            lineColor: '#7c3aed',
            secondaryColor: '#f8f6fc',
            secondaryTextColor: '#3b0764',
            secondaryBorderColor: '#9333ea',
            tertiaryColor: '#ffffff',
            tertiaryTextColor: '#4a445e',
            tertiaryBorderColor: '#c084fc',
            mainBkg: '#ffffff',
            nodeBorder: '#7c3aed',
            nodeTextColor: '#120e24',
            clusterBkg: '#f8f6fc',
            clusterBorder: '#e6e0f2',
            titleColor: '#120e24',
            edgeLabelBackground: '#ffffff',
          },
      mindmap: {
        padding: 16,
        useMaxWidth: true,
      },
    };
  }

  let lightboxModal = null;
  let activeModalCleanup = null;

  function getOrCreateLightboxModal() {
    if (lightboxModal && document.body.contains(lightboxModal)) {
      return lightboxModal;
    }
    const modal = document.createElement('div');
    modal.id = 'mermaid-lightbox-modal';
    modal.className = 'mermaid-lightbox-modal';
    modal.setAttribute('role', 'dialog');
    modal.setAttribute('aria-modal', 'true');
    modal.setAttribute('aria-label', 'Fullscreen Diagram Viewer');
    modal.innerHTML = `
      <div class="mermaid-modal-header">
        <div class="mermaid-modal-title-cluster">
          <span class="mermaid-status-dot" aria-hidden="true"></span>
          <span class="mermaid-modal-title">INTERACTIVE DIAGRAM</span>
          <span class="mermaid-modal-subtitle">Fullscreen Visual Architecture</span>
        </div>
        <div class="mermaid-modal-actions">
          <div class="mermaid-toolbar" role="toolbar" aria-label="Modal Diagram Controls">
            <button type="button" class="mermaid-tool-btn modal-zoom-out" title="Zoom Out (-)" aria-label="Zoom out">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
            <button type="button" class="mermaid-tool-btn mermaid-zoom-badge modal-zoom-badge" title="Reset Zoom (100%)" aria-label="Reset zoom level">
              <span class="zoom-value">100%</span>
            </button>
            <button type="button" class="mermaid-tool-btn modal-zoom-in" title="Zoom In (+)" aria-label="Zoom in">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
            <button type="button" class="mermaid-tool-btn modal-reset" title="Fit / Center Diagram (0)" aria-label="Reset position and zoom">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
            </button>
            <button type="button" class="mermaid-tool-btn modal-copy" title="Copy Mermaid Source Code" aria-label="Copy source code">
              <svg class="icon-copy-default" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <svg class="icon-copy-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none; color:var(--color-success-text);">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          </div>
          <button type="button" class="mermaid-modal-close-btn" title="Close Fullscreen (Esc)" aria-label="Close fullscreen modal">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
      <div class="mermaid-modal-body" tabindex="0" role="region" aria-label="Fullscreen Diagram Canvas">
        <div class="mermaid-stage"></div>
        <div class="mermaid-modal-footer-hint" aria-hidden="true">
          <span>Drag to pan • Scroll to zoom • Double-click to zoom • Press Esc to close</span>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    lightboxModal = modal;
    return modal;
  }

  function openLightbox(title, subtitle, svgMarkup, code) {
    const modal = getOrCreateLightboxModal();
    if (activeModalCleanup) activeModalCleanup();

    const titleEl = modal.querySelector('.mermaid-modal-title');
    const subtitleEl = modal.querySelector('.mermaid-modal-subtitle');
    const bodyEl = modal.querySelector('.mermaid-modal-body');
    const stageEl = modal.querySelector('.mermaid-modal-body .mermaid-stage');
    const closeBtn = modal.querySelector('.mermaid-modal-close-btn');
    const zoomInBtn = modal.querySelector('.modal-zoom-in');
    const zoomOutBtn = modal.querySelector('.modal-zoom-out');
    const resetBtn = modal.querySelector('.modal-reset');
    const zoomBadge = modal.querySelector('.modal-zoom-badge');
    const zoomValue = modal.querySelector('.modal-zoom-badge .zoom-value');
    const copyBtn = modal.querySelector('.modal-copy');

    if (titleEl) titleEl.textContent = title || 'INTERACTIVE DIAGRAM';
    if (subtitleEl) subtitleEl.textContent = subtitle || 'Fullscreen Visual Architecture';

    stageEl.innerHTML = svgMarkup;

    let modalState = { panX: 0, panY: 0, scale: 1.0 };
    const updateModalTransform = () => {
      stageEl.style.transform = `translate(${modalState.panX}px, ${modalState.panY}px) scale(${modalState.scale})`;
      if (zoomValue) zoomValue.textContent = `${Math.round(modalState.scale * 100)}%`;
    };
    updateModalTransform();

    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const onPointerDown = (e) => {
      if (e.button !== 0) return;
      isDragging = true;
      startX = e.clientX - modalState.panX;
      startY = e.clientY - modalState.panY;
      bodyEl.setPointerCapture(e.pointerId);
      bodyEl.classList.add('is-dragging');
      stageEl.classList.remove('is-resetting');
    };

    const onPointerMove = (e) => {
      if (!isDragging) return;
      modalState.panX = e.clientX - startX;
      modalState.panY = e.clientY - startY;
      updateModalTransform();
    };

    const onPointerUp = (e) => {
      if (!isDragging) return;
      isDragging = false;
      try { bodyEl.releasePointerCapture(e.pointerId); } catch (_) {}
      bodyEl.classList.remove('is-dragging');
    };

    const onWheel = (e) => {
      e.preventDefault();
      const rect = bodyEl.getBoundingClientRect();
      const cursorX = e.clientX - rect.left - rect.width / 2;
      const cursorY = e.clientY - rect.top - rect.height / 2;

      const delta = -Math.sign(e.deltaY) * 0.15;
      const oldScale = modalState.scale;
      const newScale = Math.min(Math.max(modalState.scale + delta, 0.2), 6.0);

      if (newScale !== oldScale) {
        const ratio = newScale / oldScale;
        modalState.panX = cursorX - (cursorX - modalState.panX) * ratio;
        modalState.panY = cursorY - (cursorY - modalState.panY) * ratio;
        modalState.scale = newScale;
        updateModalTransform();
      }
    };

    const onDblClick = (e) => {
      stageEl.classList.add('is-resetting');
      if (Math.abs(modalState.scale - 1.0) < 0.1) {
        modalState.scale = 2.0;
        const rect = bodyEl.getBoundingClientRect();
        modalState.panX = -(e.clientX - rect.left - rect.width / 2);
        modalState.panY = -(e.clientY - rect.top - rect.height / 2);
      } else {
        modalState.scale = 1.0;
        modalState.panX = 0;
        modalState.panY = 0;
      }
      updateModalTransform();
    };

    const onZoomIn = () => {
      stageEl.classList.remove('is-resetting');
      modalState.scale = Math.min(modalState.scale + 0.25, 6.0);
      updateModalTransform();
    };

    const onZoomOut = () => {
      stageEl.classList.remove('is-resetting');
      modalState.scale = Math.max(modalState.scale - 0.25, 0.2);
      updateModalTransform();
    };

    const onReset = () => {
      stageEl.classList.add('is-resetting');
      modalState.scale = 1.0;
      modalState.panX = 0;
      modalState.panY = 0;
      updateModalTransform();
    };

    const onCopy = async () => {
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const iconDef = copyBtn?.querySelector('.icon-copy-default');
        const iconSucc = copyBtn?.querySelector('.icon-copy-success');
        if (iconDef) iconDef.style.display = 'none';
        if (iconSucc) iconSucc.style.display = 'inline-block';
        setTimeout(() => {
          if (iconDef) iconDef.style.display = 'inline-block';
          if (iconSucc) iconSucc.style.display = 'none';
        }, 2000);
      } catch (err) {
        console.warn('Failed to copy code:', err);
      }
    };

    const closeModal = () => {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      if (activeModalCleanup) {
        activeModalCleanup();
        activeModalCleanup = null;
      }
    };

    const onKeyDown = (e) => {
      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === '+' || e.key === '=') {
        onZoomIn();
      } else if (e.key === '-' || e.key === '_') {
        onZoomOut();
      } else if (e.key === '0') {
        onReset();
      } else if (e.key === 'ArrowUp') {
        modalState.panY += 40;
        updateModalTransform();
      } else if (e.key === 'ArrowDown') {
        modalState.panY -= 40;
        updateModalTransform();
      } else if (e.key === 'ArrowLeft') {
        modalState.panX += 40;
        updateModalTransform();
      } else if (e.key === 'ArrowRight') {
        modalState.panX -= 40;
        updateModalTransform();
      }
    };

    bodyEl.addEventListener('pointerdown', onPointerDown);
    bodyEl.addEventListener('pointermove', onPointerMove);
    bodyEl.addEventListener('pointerup', onPointerUp);
    bodyEl.addEventListener('pointercancel', onPointerUp);
    bodyEl.addEventListener('wheel', onWheel, { passive: false });
    bodyEl.addEventListener('dblclick', onDblClick);
    zoomInBtn?.addEventListener('click', onZoomIn);
    zoomOutBtn?.addEventListener('click', onZoomOut);
    resetBtn?.addEventListener('click', onReset);
    zoomBadge?.addEventListener('click', onReset);
    copyBtn?.addEventListener('click', onCopy);
    closeBtn?.addEventListener('click', closeModal);
    window.addEventListener('keydown', onKeyDown);

    activeModalCleanup = () => {
      bodyEl.removeEventListener('pointerdown', onPointerDown);
      bodyEl.removeEventListener('pointermove', onPointerMove);
      bodyEl.removeEventListener('pointerup', onPointerUp);
      bodyEl.removeEventListener('pointercancel', onPointerUp);
      bodyEl.removeEventListener('wheel', onWheel);
      bodyEl.removeEventListener('dblclick', onDblClick);
      zoomInBtn?.removeEventListener('click', onZoomIn);
      zoomOutBtn?.removeEventListener('click', onZoomOut);
      resetBtn?.removeEventListener('click', onReset);
      zoomBadge?.removeEventListener('click', onReset);
      copyBtn?.removeEventListener('click', onCopy);
      closeBtn?.removeEventListener('click', closeModal);
      window.removeEventListener('keydown', onKeyDown);
    };

    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function setupDiagramCard(targetWrapper, svgMarkup, code) {
    const title = targetWrapper.dataset.mermaidTitle || 'INTERACTIVE DIAGRAM';
    const subtitle = targetWrapper.dataset.mermaidSubtitle || 'Visual Architecture';

    const stage = targetWrapper.querySelector('.mermaid-stage');
    if (stage) stage.innerHTML = svgMarkup;

    const canvas = targetWrapper.querySelector('.mermaid-card-canvas');
    const zoomInBtn = targetWrapper.querySelector('.mermaid-btn-zoom-in');
    const zoomOutBtn = targetWrapper.querySelector('.mermaid-btn-zoom-out');
    const resetBtn = targetWrapper.querySelector('.mermaid-btn-reset');
    const zoomBadge = targetWrapper.querySelector('.mermaid-zoom-badge');
    const zoomVal = targetWrapper.querySelector('.mermaid-zoom-badge .zoom-value');
    const copyBtn = targetWrapper.querySelector('.mermaid-btn-copy');
    const fsBtn = targetWrapper.querySelector('.mermaid-btn-fullscreen');

    if (!canvas || !stage) return;

    let state = { panX: 0, panY: 0, scale: 1.0 };
    const updateTransform = () => {
      stage.style.transform = `translate(${state.panX}px, ${state.panY}px) scale(${state.scale})`;
      if (zoomVal) zoomVal.textContent = `${Math.round(state.scale * 100)}%`;
    };

    let isDragging = false;
    let startX = 0;
    let startY = 0;

    canvas.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      isDragging = true;
      startX = e.clientX - state.panX;
      startY = e.clientY - state.panY;
      canvas.setPointerCapture(e.pointerId);
      canvas.classList.add('is-dragging');
      stage.classList.remove('is-resetting');
    });

    canvas.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      state.panX = e.clientX - startX;
      state.panY = e.clientY - startY;
      updateTransform();
    });

    const stopDragging = (e) => {
      if (!isDragging) return;
      isDragging = false;
      try { canvas.releasePointerCapture(e.pointerId); } catch (_) {}
      canvas.classList.remove('is-dragging');
    };
    canvas.addEventListener('pointerup', stopDragging);
    canvas.addEventListener('pointercancel', stopDragging);

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      const cursorX = e.clientX - rect.left - rect.width / 2;
      const cursorY = e.clientY - rect.top - rect.height / 2;

      const delta = -Math.sign(e.deltaY) * 0.15;
      const oldScale = state.scale;
      const newScale = Math.min(Math.max(state.scale + delta, 0.3), 5.0);

      if (newScale !== oldScale) {
        const ratio = newScale / oldScale;
        state.panX = cursorX - (cursorX - state.panX) * ratio;
        state.panY = cursorY - (cursorY - state.panY) * ratio;
        state.scale = newScale;
        stage.classList.remove('is-resetting');
        updateTransform();
      }
    }, { passive: false });

    canvas.addEventListener('dblclick', (e) => {
      stage.classList.add('is-resetting');
      if (Math.abs(state.scale - 1.0) < 0.1) {
        state.scale = 2.0;
        const rect = canvas.getBoundingClientRect();
        state.panX = -(e.clientX - rect.left - rect.width / 2);
        state.panY = -(e.clientY - rect.top - rect.height / 2);
      } else {
        state.scale = 1.0;
        state.panX = 0;
        state.panY = 0;
      }
      updateTransform();
    });

    zoomInBtn?.addEventListener('click', () => {
      stage.classList.remove('is-resetting');
      state.scale = Math.min(state.scale + 0.25, 5.0);
      updateTransform();
    });

    zoomOutBtn?.addEventListener('click', () => {
      stage.classList.remove('is-resetting');
      state.scale = Math.max(state.scale - 0.25, 0.3);
      updateTransform();
    });

    const resetAction = () => {
      stage.classList.add('is-resetting');
      state.scale = 1.0;
      state.panX = 0;
      state.panY = 0;
      updateTransform();
    };

    resetBtn?.addEventListener('click', resetAction);
    zoomBadge?.addEventListener('click', resetAction);

    copyBtn?.addEventListener('click', async () => {
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const iconDef = copyBtn.querySelector('.icon-copy-default');
        const iconSucc = copyBtn.querySelector('.icon-copy-success');
        if (iconDef) iconDef.style.display = 'none';
        if (iconSucc) iconSucc.style.display = 'inline-block';
        setTimeout(() => {
          if (iconDef) iconDef.style.display = 'inline-block';
          if (iconSucc) iconSucc.style.display = 'none';
        }, 2000);
      } catch (err) {
        console.warn('Failed to copy code:', err);
      }
    });

    fsBtn?.addEventListener('click', () => {
      openLightbox(title, subtitle, svgMarkup, code);
    });
  }

  async function renderMermaidDiagrams() {
    const mermaid = await loadMermaid();
    if (!mermaid) return;

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    mermaid.initialize(getMermaidConfig(isDark));

    const cards = document.querySelectorAll('.mermaid-diagram-card');
    let idx = 0;
    for (const card of cards) {
      try {
        const code = card.dataset.mermaidSource?.trim() || '';
        if (!code) continue;

        const uniqueId = `mermaid-demo-${Date.now()}-${idx++}`;
        const { svg } = await mermaid.render(uniqueId, code);
        setupDiagramCard(card, svg, code);
      } catch (err) {
        console.warn('Failed to render Mermaid diagram in demo:', err);
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
  } else {
    renderMermaidDiagrams();
  }

  window.addEventListener('theme-changed', renderMermaidDiagrams);
  const observer = new MutationObserver(renderMermaidDiagrams);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>


