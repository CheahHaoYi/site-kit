---
import Layout from '../components/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Table from '../components/Table.astro';
import Callout from '../components/Callout.astro';
import Tag from '../components/Tag.astro';
import Badge from '../components/Badge.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const breadcrumbsData = [
  { label: 'Network & AI Security', href: '/' },
  { label: 'Design System', href: '/' },
  { label: 'Living Component Baseline' },
];

const sampleSubnetHeaders = ['CIDR / Prefix', 'Subnet Mask', 'Total IPs', 'Usable Hosts', 'Use Case'];
const sampleSubnetRows = [
  ['/30', '255.255.255.252', 4, 2, 'Point-to-Point Router Links & BGP Peering'],
  ['/28', '255.255.255.240', 16, 14, 'Small DMZ / AI Model Cluster Gateway'],
  ['/24', '255.255.255.0', 256, 254, 'Standard Department VLAN / Kubernetes Pod Subnet'],
  ['/22', '255.255.252.0', 1024, 1022, 'Enterprise Campus Floor / Multi-Rack Data Center'],
];

const bashExample = `# Configure persistent VLAN interface & firewall zone (RHEL 9 / RHCSA)
sudo nmcli connection add type vlan con-name vlan100 dev eth0 id 100 ip4 10.100.1.1/24
sudo firewall-cmd --zone=internal --add-interface=vlan100 --permanent
sudo firewall-cmd --reload
sudo firewall-cmd --zone=internal --list-all`;

const pythonExample = `"""
AI Security: Prompt Injection & Tool Calling Guardrail
Validates input telemetry before executing tool calls.
"""
from typing import Dict, Any
import re

def inspect_prompt_payload(prompt: str, user_context: Dict[str, Any]) -> bool:
    forbidden_patterns = [
        r"ignore previous instructions",
        r"system prompt override",
        r"<script.*?>",
    ]
    for pattern in forbidden_patterns:
        if re.search(pattern, prompt, re.IGNORECASE):
            return False  # Security trigger: quarantine payload
    return True`;

const iosColors = [
  { name: 'Purple (Key)', token: '--ios-purple', hex: '#af52de', role: 'Primary Accent & Dynamic Seed' },
  { name: 'Indigo', token: '--ios-indigo', hex: '#5856d6', role: 'Secondary Tonal & Deep Accents' },
  { name: 'Blue', token: '--ios-blue', hex: '#007aff', role: 'Interactive Links & Info Banners' },
  { name: 'Mint / Teal', token: '--ios-mint', hex: '#00c7be', role: 'Security Audits & Telemetry OK' },
  { name: 'Green', token: '--ios-green', hex: '#34c759', role: 'Passed Exams & Active Nodes' },
  { name: 'Orange', token: '--ios-orange', hex: '#ff9500', role: 'Warnings & Packet Loss Alerts' },
  { name: 'Pink / Red', token: '--ios-pink', hex: '#ff2d55', role: 'Critical Vulnerabilities & CVEs' },
];

const tonalPurplePalette = [
  { level: 'Primary', token: '--color-accent-primary', hex: '#7c3aed', desc: 'Main interactive buttons, active indicators' },
  { level: 'Primary Container', token: '--color-accent-subtle', hex: '#f3e8ff', desc: 'Tonal secondary buttons, active pills' },
  { level: 'On-Container', token: '--color-accent-on-container', hex: '#581c87', desc: 'High-contrast typography on tonal beds' },
  { level: 'Surface Container Low', token: '--color-bg-surface-container-low', hex: '#f8f6fc', desc: 'Soft inset backgrounds, table striping' },
  { level: 'Surface Container Level 1', token: '--color-bg-surface-container', hex: '#f2eefa', desc: 'M3 Base container, tags, badges' },
  { level: 'Surface Container Level 2', token: '--color-bg-surface-container-high', hex: '#e9e2f6', desc: 'Elevated hover layers, modal headers' },
];
---

<Layout
  title="Style Guide & Living Baseline"
  description="High-end design system synthesizing Apple Human Interface Guidelines and Google Material Design 3. Light mode by default with dark mode alternative."
  breadcrumbs={breadcrumbsData}
>
  <div class="container page-wrapper">
    <!-- 1. Hero Section (Apple Generous Whitespace & Minimalist Split) -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="eyebrow-cluster">
          <Badge pill={true} iosColor="purple" pulse={true}>
            SYSTEM STATUS: OPERATIONAL
          </Badge>
          <Tag pill={true} variant="cert">Light Mode Default</Tag>
          <Tag pill={true} variant="outline">Dark Mode Alternative</Tag>
          <Tag pill={true} variant="outline">Key Color: Purple</Tag>
        </div>

        <h1 class="hero-title">
          Precision Systems Design for Network &amp; AI Security
        </h1>

        <p class="hero-lead">
          The single source of truth design system synthesized from <strong>Apple Human Interface Guidelines</strong> 
          (San Francisco typography, translucent frosted glass, native iOS system colors, spring motion) and 
          <strong>Google Material Design 3</strong> (dynamic purple tonal palettes, prominent surface elevations, pill containers).
        </p>

        <div class="hero-actions">
          <Button href="/demo" variant="primary" size="lg" pill={true}>
            <span>Explore Design Benchmark</span>
            <span class="btn-icon-wrapper" aria-hidden="true">&rarr;</span>
          </Button>

          <Button href="#tonal-system" variant="secondary" size="lg" pill={true}>
            <span>Inspect Tonal Tokens</span>
          </Button>
        </div>
      </div>

      <!-- Quick Interactive Theme Control Card (Double-Bezel Architecture) -->
      <div class="hero-preview-card">
        <Card variant="glass" doubleBezel={true} class="hero-glass-card">
          <div class="live-theme-box">
            <div class="live-theme-box__header">
              <span class="live-theme-box__dot"></span>
              <div>
                <h4 class="live-theme-box__title">Live Interface Controller</h4>
                <p class="live-theme-box__desc">Instant zero-flash synchronization with localStorage</p>
              </div>
            </div>

            <div class="live-theme-toggle-row">
              <span class="theme-state-label">Current State: <strong id="theme-status-text">Light Mode (Default)</strong></span>
              <ThemeToggle size="md" />
            </div>

            <div class="live-metrics-grid">
              <div class="metric-item">
                <span class="metric-label">Primary Seed</span>
                <span class="metric-val" style="color: var(--color-accent-primary);">#7C3AED</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">Motion Curve</span>
                <span class="metric-val">Spring Fluid</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">WCAG Target</span>
                <span class="metric-val">AAA Compliant</span>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </section>

    <!-- 2. Dynamic Color & Tonal System (Google M3 + Apple iOS Colors) -->
    <section id="tonal-system" class="section-block">
      <div class="section-header">
        <Badge pill={true} iosColor="indigo">DYNAMIC COLOR ARCHITECTURE</Badge>
        <h2 class="section-title">Google Material 3 Tonal Palette &amp; Native iOS Colors</h2>
        <p class="section-desc">
          All surface elevations, container backgrounds, and state layers are dynamically derived from the key color 
          <strong>Purple (#7c3aed)</strong>, combined with native Apple iOS system colors for status telemetry.
        </p>
      </div>

      <!-- M3 Purple Tonal Layers -->
      <h3 class="subsection-title">Derived Purple Tonal Palette (M3 Container Roles)</h3>
      <div class="tonal-palette-grid">
        {tonalPurplePalette.map((item) => (
          <div class="tonal-card">
            <div class="tonal-swatch" style={`background-color: var(${item.token});`}></div>
            <div class="tonal-meta">
              <span class="tonal-level">{item.level}</span>
              <code class="tonal-token">{item.token}</code>
              <span class="tonal-desc">{item.desc}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Apple iOS Native System Colors -->
      <h3 class="subsection-title" style="margin-top: var(--space-8);">Native Apple iOS System Colors</h3>
      <div class="ios-colors-grid">
        {iosColors.map((color) => (
          <div class="ios-color-chip">
            <span class="ios-color-dot" style={`background-color: var(${color.token});`}></span>
            <div class="ios-color-info">
              <span class="ios-color-name">{color.name}</span>
              <code class="ios-color-token">{color.token}</code>
              <span class="ios-color-role">{color.role}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Doppelrand (Double-Bezel) & Apple Glassmorphism Cards -->
    <section class="section-block">
      <div class="section-header">
        <Badge pill={true} iosColor="mint">HARDWARE ARCHITECTURE</Badge>
        <h2 class="section-title">Double-Bezel Nested Enclosures &amp; Translucent Glass</h2>
        <p class="section-desc">
          Components feature physical hardware-inspired double-bezel nested enclosures (concentric squircle curves) 
          and translucent frosted glass with top specular rim reflections.
        </p>
      </div>

      <div class="cards-grid">
        <Card
          title="CISSP Domain 4: Network Security"
          description="Deep dive into cryptographic protocols, BGP route security, and zero-trust transport boundary architecture."
          href="#"
          badge="CISSP 2026"
          badgeVariant="cert"
          date="Domain 04"
          variant="glass"
          doubleBezel={true}
          tags={['BGP RPKI', 'IPSec IKEv2', '802.1X', 'TLS 1.3']}
        />

        <Card
          title="RHCSA 9: Stratis & LVM Thin Pools"
          description="Automating storage allocation, snapshot management, and systemd timer integration on Red Hat Enterprise Linux 9."
          href="#"
          badge="RHCSA"
          badgeVariant="default"
          date="Storage"
          variant="tonal"
          doubleBezel={true}
          tags={['Stratis', 'LVM', 'systemd', 'XFS']}
        />

        <Card
          title="AI Security: LLM Prompt Firewalls"
          description="Real-time heuristic & semantic inspection pipelines defending against jailbreaks and unauthorized tool invocation."
          href="#"
          badge="AI Security"
          badgeVariant="accent"
          date="Research"
          variant="glass"
          doubleBezel={true}
          tags={['Guardrails', 'LangChain', 'AST Filter', 'FastAPI']}
        />
      </div>
    </section>

    <!-- 4. Pill Components & Button-in-Button CTA Architecture -->
    <section class="section-block">
      <div class="section-header">
        <Badge pill={true} iosColor="purple">PILL CONTAINERS &amp; INTERACTIVE CONTROLS</Badge>
        <h2 class="section-title">Nested CTAs, Pill Containers &amp; Tactile Micro-Press</h2>
        <p class="section-desc">
          Interactive controls feature Apple-style rounded pill geometry, tactile spring micro-press physics 
          (`active: scale(0.975)`), and nested button-in-button trailing icon kinetic animations.
        </p>
      </div>

      <div class="interactive-showcase-box">
        <div class="interactive-group">
          <h4 class="group-title">Button-in-Button Action Pills</h4>
          <div class="buttons-row">
            <Button variant="primary" pill={true} size="lg">
              <span>Deploy Firewall Policy</span>
              <span class="btn-icon-wrapper">&rarr;</span>
            </Button>

            <Button variant="secondary" pill={true} size="lg">
              <span>View Route Table</span>
              <span class="btn-icon-wrapper">&#8600;</span>
            </Button>

            <Button variant="outline" pill={true} size="lg">
              <span>Download Schema</span>
              <span class="btn-icon-wrapper">&#8595;</span>
            </Button>

            <Button variant="danger" pill={true} size="lg">
              <span>Quarantine Host</span>
              <span class="btn-icon-wrapper">&times;</span>
            </Button>
          </div>
        </div>

        <div class="interactive-group" style="margin-top: var(--space-6);">
          <h4 class="group-title">Status Pills &amp; Telemetry Tags</h4>
          <div class="pills-row">
            <Badge pill={true} iosColor="purple" pulse={true}>Core BGP Mesh</Badge>
            <Badge pill={true} iosColor="mint">Zero Packet Drop</Badge>
            <Badge pill={true} iosColor="indigo">Mutual TLS Active</Badge>
            <Badge pill={true} iosColor="orange">BGP Flap Warning</Badge>
            <Badge pill={true} iosColor="pink">CVE-2026-1188</Badge>
            <Tag pill={true} interactive={true}>#cisco-ios-xe</Tag>
            <Tag pill={true} interactive={true}>#wireguard</Tag>
            <Tag pill={true} interactive={true}>#ebpf-xdp</Tag>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Dual Shiki Code Highlighting & Technical Data Tables -->
    <section class="section-block">
      <div class="section-header">
        <Badge pill={true} iosColor="blue">DUAL SHIKI HIGHLIGHTING</Badge>
        <h2 class="section-title">High-Contrast Technical Code &amp; Inset Tables</h2>
        <p class="section-desc">
          Code blocks use official Shiki engine with dual themes (GitHub Light in default light mode, GitHub Dark in dark mode). 
          Data tables provide safe horizontal scrolling with zero squishing on mobile.
        </p>
      </div>

      <div class="code-and-table-grid">
        <div>
          <CodeBlock
            code={bashExample}
            lang="bash"
            filename="vlan-automation.sh"
            showLineNumbers={true}
          />
        </div>

        <div>
          <CodeBlock
            code={pythonExample}
            lang="python"
            filename="prompt_guardrail.py"
            showLineNumbers={true}
          />
        </div>
      </div>

      <div style="margin-top: var(--space-8);">
        <Table
          headers={sampleSubnetHeaders}
          rows={sampleSubnetRows}
          caption="IPv4 Subnet Planning Matrix (Network Engineering Reference)"
          striped={true}
        />
      </div>
    </section>

    <!-- 6. Semantic Callouts & Notices -->
    <section class="section-block">
      <div class="section-header">
        <Badge pill={true} iosColor="orange">SEMANTIC CALLOUTS</Badge>
        <h2 class="section-title">Tactile Notices &amp; Certification Callouts</h2>
      </div>

      <div class="callouts-grid">
        <Callout variant="tip" title="CISSP Exam Tip — Asymmetric Key Management">
          When encrypting data at rest using envelope encryption (DEK/KEK), the data encryption key is generated locally 
          by symmetric AES-256 and wrapped by the public key of the KMS master key.
        </Callout>

        <Callout variant="warning" title="BGP Route Origin Validation (ROV)">
          Always ensure Network Time Protocol (NTP) is synchronized with authoritative stratum-1 sources before enabling 
          RPKI validation, as ROA validity states expire strictly based on UTC timestamps.
        </Callout>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    padding-top: var(--space-8);
    padding-bottom: var(--space-24);
  }

  /* 1. Hero Section */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    padding-top: var(--space-6);
  }

  @media (min-width: 960px) {
    .hero-section {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-12);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .eyebrow-cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .hero-title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    font-weight: var(--font-weight-heavy);
    color: var(--color-text-primary);
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: var(--text-4xl);
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }

  .hero-lead {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 62ch;
  }

  @media (min-width: 640px) {
    .hero-lead {
      font-size: var(--text-lg);
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Hero Live Theme Box */
  .hero-preview-card {
    width: 100%;
  }

  .live-theme-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .live-theme-box__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .live-theme-box__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
    box-shadow: 0 0 12px var(--color-accent-primary);
  }

  .live-theme-box__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .live-theme-box__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .live-theme-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-surface-container);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  .theme-state-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .live-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    text-align: center;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-2-5);
    background-color: var(--color-bg-surface-container-low);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .metric-val {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xs);
    color: var(--color-text-primary);
    margin-top: var(--space-0-5);
  }

  /* Section Styles */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 75ch;
  }

  .section-title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: var(--text-3xl);
    }
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .subsection-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  /* Tonal Palette Grid */
  .tonal-palette-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .tonal-palette-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tonal-palette-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tonal-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .tonal-swatch {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }

  .tonal-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
  }

  .tonal-level {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .tonal-token {
    font-size: var(--text-2xs);
    color: var(--color-accent-primary);
  }

  .tonal-desc {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  /* iOS Colors Grid */
  .ios-colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2-5);
  }

  @media (min-width: 640px) {
    .ios-colors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .ios-colors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ios-color-chip {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2-5) var(--space-3);
    background-color: var(--color-bg-surface-container);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
  }

  .ios-color-dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ios-color-info {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .ios-color-name {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .ios-color-token {
    font-size: 0.625rem;
    color: var(--color-text-muted);
  }

  .ios-color-role {
    font-size: 0.625rem;
    color: var(--color-text-secondary);
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Interactive Showcase Box */
  .interactive-showcase-box {
    padding: var(--space-6);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-sm);
  }

  .group-title {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .buttons-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Code Grid */
  .code-and-table-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .code-and-table-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Callouts Grid */
  .callouts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .callouts-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    const updateThemeStatus = () => {
      const el = document.getElementById('theme-status-text');
      if (!el) return;
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      el.textContent = current === 'dark' ? 'Dark Mode (Alternative)' : 'Light Mode (Default)';
    };

    updateThemeStatus();

    const observer = new MutationObserver(updateThemeStatus);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>
