---
import type { BadgeProps } from '../types';

interface Props extends BadgeProps {}

const {
  variant = 'default',
  size = 'md',
  pulse = false,
  pill = true,
  iosColor,
  class: className = '',
} = Astro.props;
---

<span
  class:list={[
    'badge',
    `badge--${variant}`,
    `badge--${size}`,
    { 'badge--pill': pill },
    iosColor ? `badge--ios-${iosColor}` : undefined,
    className,
  ]}
>
  {pulse && <span class="badge__pulse" aria-hidden="true" />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    font-family: var(--font-display);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    line-height: var(--leading-none);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2-5);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-surface-container);
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .badge--pill {
    border-radius: var(--radius-full);
  }

  .badge--sm {
    font-size: 0.625rem; /* 10px */
    padding: 0.125rem 0.375rem;
  }

  .badge--md {
    font-size: var(--text-2xs);
    padding: var(--space-1) var(--space-2-5);
  }

  /* Variants */
  .badge--default {
    background-color: var(--color-bg-surface-container);
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }

  .badge--accent {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .badge--cert {
    background-color: var(--color-bg-surface);
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    box-shadow: var(--shadow-sm);
  }

  .badge--success {
    background-color: var(--color-success-bg);
    color: var(--color-success-text);
    border-color: var(--color-success-border);
  }

  .badge--warning {
    background-color: var(--color-warning-bg);
    color: var(--color-warning-text);
    border-color: var(--color-warning-border);
  }

  .badge--danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger-text);
    border-color: var(--color-danger-border);
  }

  .badge--outline {
    background-color: transparent;
    border-color: var(--color-border-hover);
    color: var(--color-text-secondary);
  }

  /* Native iOS Color Variants */
  .badge--ios-purple {
    background-color: rgba(175, 82, 222, 0.12);
    color: var(--ios-purple);
    border-color: rgba(175, 82, 222, 0.3);
  }

  .badge--ios-indigo {
    background-color: rgba(88, 86, 214, 0.12);
    color: var(--ios-indigo);
    border-color: rgba(88, 86, 214, 0.3);
  }

  .badge--ios-blue {
    background-color: rgba(0, 122, 255, 0.12);
    color: var(--ios-blue);
    border-color: rgba(0, 122, 255, 0.3);
  }

  .badge--ios-mint {
    background-color: rgba(0, 199, 190, 0.12);
    color: var(--ios-mint);
    border-color: rgba(0, 199, 190, 0.3);
  }

  .badge--ios-green {
    background-color: rgba(52, 199, 89, 0.12);
    color: var(--ios-green);
    border-color: rgba(52, 199, 89, 0.3);
  }

  .badge--ios-orange {
    background-color: rgba(255, 149, 0, 0.12);
    color: var(--ios-orange);
    border-color: rgba(255, 149, 0, 0.3);
  }

  .badge--ios-pink {
    background-color: rgba(255, 45, 85, 0.12);
    color: var(--ios-pink);
    border-color: rgba(255, 45, 85, 0.3);
  }

  /* Telemetry Status Pulse Dot */
  .badge__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
    display: inline-block;
    position: relative;
    flex-shrink: 0;
  }

  .badge__pulse::after {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0.4;
    animation: badge-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes badge-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.4;
    }
    50% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
</style>
