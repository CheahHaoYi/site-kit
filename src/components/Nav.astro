---
import type { NavProps } from '../types';
import { resolveUrl } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';

interface Props extends NavProps {}

const {
  brandTitle = 'Hao Yi Cheah',
  brandSubtitle = 'Network & AI Security',
  links = [
    { label: 'Overview', href: '/' },
    { label: 'Design Benchmark', href: '/demo' },
    { label: 'CISSP', href: '/cissp' },
    { label: 'RHCSA', href: '/rhcsa' },
    { label: 'CCNA', href: '/ccna' },
    { label: 'Projects', href: '/projects' },
  ],
  currentPath = '',
  showThemeToggle = true,
  class: className = '',
} = Astro.props;

const homeUrl = resolveUrl('/');
const normalizedCurrentPath = currentPath.replace(/\/+$/, '') || '/';
---

<header class:list={['site-nav-wrapper', className]}>
  <div class="site-nav-island container">
    <!-- Brand / Logo -->
    <a href={homeUrl} class="site-brand" aria-label={`${brandTitle} - Home`}>
      <span class="site-brand__signal" aria-hidden="true"></span>
      <div class="site-brand__text">
        <span class="site-brand__title">{brandTitle}</span>
        {brandSubtitle && <span class="site-brand__subtitle">{brandSubtitle}</span>}
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="site-nav-links" aria-label="Primary Navigation">
      {links.map((link) => {
        const resolved = resolveUrl(link.href);
        const isCurrent = link.active ?? (
          link.href === '/'
            ? normalizedCurrentPath === '/' || normalizedCurrentPath === resolveUrl('/')
            : normalizedCurrentPath.startsWith(resolved)
        );

        return (
          <a
            href={resolved}
            class:list={['nav-link', { 'nav-link--active': isCurrent }]}
            aria-current={isCurrent ? 'page' : undefined}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Nav Controls (Theme Toggle & Mobile Menu Button) -->
    <div class="site-nav-actions">
      {showThemeToggle && <ThemeToggle size="sm" />}

      <button
        type="button"
        id="mobile-nav-toggle"
        class="mobile-menu-btn"
        aria-label="Open main menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg
          class="menu-icon menu-icon--open"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg
          class="menu-icon menu-icon--close"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" x2="6" y1="6" y2="18"></line>
          <line x1="6" x2="18" y1="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer__overlay" id="mobile-nav-backdrop"></div>
    <div class="mobile-drawer__content">
      <div class="mobile-drawer__header">
        <div class="site-brand">
          <span class="site-brand__signal" aria-hidden="true"></span>
          <div class="site-brand__text">
            <span class="site-brand__title">{brandTitle}</span>
          </div>
        </div>
        <button
          type="button"
          id="mobile-nav-close"
          class="mobile-drawer__close-btn"
          aria-label="Close menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="width: 1.25rem; height: 1.25rem;"
          >
            <line x1="18" x2="6" y1="6" y2="18"></line>
            <line x1="6" x2="18" y1="6" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-drawer__links" aria-label="Mobile Navigation">
        {links.map((link) => {
          const resolved = resolveUrl(link.href);
          const isCurrent = link.active ?? (
            link.href === '/'
              ? normalizedCurrentPath === '/' || normalizedCurrentPath === resolveUrl('/')
              : normalizedCurrentPath.startsWith(resolved)
          );

          return (
            <a
              href={resolved}
              class:list={['mobile-nav-link', { 'mobile-nav-link--active': isCurrent }]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span>{link.label}</span>
              <span class="mobile-nav-arrow">&rarr;</span>
            </a>
          );
        })}
      </nav>

      {showThemeToggle && (
        <div class="mobile-drawer__theme">
          <span class="mobile-theme-label">Interface Appearance</span>
          <ThemeToggle size="md" />
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .site-nav-wrapper {
    position: sticky;
    top: var(--space-3);
    z-index: 50;
    width: 100%;
    padding: 0 var(--space-3);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .site-nav-wrapper {
      padding: 0 var(--space-4);
      top: var(--space-4);
    }
  }

  /* Floating Pill Glass Island */
  .site-nav-island {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    background-color: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md), var(--glass-rim);
    padding: 0 var(--space-4);
    pointer-events: auto;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  @media (min-width: 768px) {
    .site-nav-island {
      padding: 0 var(--space-6);
    }
  }

  /* Brand */
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2-5);
    text-decoration: none;
    user-select: none;
    color: var(--color-text-primary);
  }

  .site-brand:hover {
    text-decoration: none;
  }

  .site-brand__signal {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
    box-shadow: 0 0 10px var(--color-accent-primary);
    display: inline-block;
    flex-shrink: 0;
    animation: signal-pulse 3s infinite ease-in-out;
  }

  @keyframes signal-pulse {
    0%, 100% {
      opacity: 0.9;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.9);
    }
  }

  .site-brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .site-brand__title {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .site-brand__subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
  }

  /* Desktop Nav Links */
  .site-nav-links {
    display: none;
    align-items: center;
    gap: var(--space-1);
  }

  @media (min-width: 860px) {
    .site-nav-links {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-surface-container);
    text-decoration: none;
  }

  .nav-link--active {
    color: var(--color-accent-primary);
    background-color: var(--color-accent-subtle);
    font-weight: var(--font-weight-semibold);
  }

  /* Actions (Theme Toggle & Mobile Button) */
  .site-nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: 0;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  @media (min-width: 860px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .mobile-menu-btn:hover {
    background-color: var(--color-bg-surface-container);
    color: var(--color-text-primary);
  }

  .menu-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .menu-icon--close {
    display: none;
  }

  .mobile-menu-btn[aria-expanded="true"] .menu-icon--open {
    display: none;
  }

  .mobile-menu-btn[aria-expanded="true"] .menu-icon--close {
    display: block;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: auto;
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-bg-overlay);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    animation: drawer-fade-in 200ms var(--ease-spring);
  }

  .mobile-drawer__content {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    left: var(--space-4);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    animation: drawer-slide-down 250ms var(--ease-spring);
  }

  @keyframes drawer-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes drawer-slide-down {
    from {
      opacity: 0;
      transform: translateY(-16px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .mobile-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-drawer__close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--color-bg-surface-container);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .mobile-drawer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .mobile-nav-link:hover {
    background-color: var(--color-bg-surface-container);
    text-decoration: none;
  }

  .mobile-nav-link--active {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-primary);
    font-weight: var(--font-weight-bold);
  }

  .mobile-nav-arrow {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .mobile-drawer__theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .mobile-theme-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>

<script is:inline>
  (function () {
    const initNav = () => {
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const closeBtn = document.getElementById('mobile-nav-close');
      const drawer = document.getElementById('mobile-nav-drawer');
      const backdrop = document.getElementById('mobile-nav-backdrop');

      if (!toggleBtn || !drawer) return;

      const openDrawer = () => {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        toggleBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      };

      const closeDrawer = () => {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      };

      toggleBtn.addEventListener('click', () => {
        const isOpen = drawer.classList.contains('is-open');
        if (isOpen) closeDrawer();
        else openDrawer();
      });

      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (backdrop) backdrop.addEventListener('click', closeDrawer);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
          closeDrawer();
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNav);
    } else {
      initNav();
    }

    document.addEventListener('astro:after-swap', initNav);
  })();
</script>
