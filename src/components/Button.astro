---
import type { ButtonProps } from '../types';

interface Props extends ButtonProps {}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  target,
  rel,
  ariaLabel,
  download,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const computedRel = target === '_blank' && !rel ? 'noopener noreferrer' : rel;
---

<Tag
  href={href}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  aria-label={ariaLabel}
  target={target}
  rel={computedRel}
  download={download}
  class:list={[
    'button',
    `button--${variant}`,
    `button--${size}`,
    { 'button--disabled': disabled },
    className,
  ]}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    line-height: var(--leading-none);
    border-radius: var(--radius-md);
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
    white-space: nowrap;
    user-select: none;
  }

  .button:hover {
    text-decoration: none;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Sizes */
  .button--sm {
    font-size: var(--text-xs);
    padding: var(--space-1-5) var(--space-3);
    min-height: 1.75rem;
  }

  .button--md {
    font-size: var(--text-sm);
    padding: var(--space-2-5) var(--space-4);
    min-height: 2.25rem;
  }

  .button--lg {
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-6);
    min-height: 2.75rem;
  }

  /* Variants */
  .button--primary {
    background-color: var(--color-accent-primary);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent-primary);
    box-shadow: var(--shadow-sm);
  }

  .button--primary:hover:not(.button--disabled) {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .button--secondary {
    background-color: var(--color-bg-elevated);
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .button--secondary:hover:not(.button--disabled) {
    background-color: var(--color-bg-sunken);
    border-color: var(--color-border-hover);
  }

  .button--outline {
    background-color: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  .button--outline:hover:not(.button--disabled) {
    background-color: var(--color-bg-elevated);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .button--ghost {
    background-color: transparent;
    color: var(--color-text-secondary);
    border-color: transparent;
  }

  .button--ghost:hover:not(.button--disabled) {
    background-color: var(--color-bg-elevated);
    color: var(--color-text-primary);
  }

  .button--danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger-text);
    border-color: var(--color-danger-border);
  }

  .button--danger:hover:not(.button--disabled) {
    background-color: var(--color-danger-icon);
    color: #ffffff;
    border-color: var(--color-danger-icon);
  }

  /* Disabled State */
  .button--disabled,
  .button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    box-shadow: none;
  }
</style>
