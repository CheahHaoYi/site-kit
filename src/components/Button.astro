---
import type { ButtonProps } from '../types';

interface Props extends ButtonProps {}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  pill = false,
  class: className = '',
  target,
  rel,
  ariaLabel,
  download,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const computedRel = target === '_blank' && !rel ? 'noopener noreferrer' : rel;
---

<Tag
  href={href}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  aria-label={ariaLabel}
  target={target}
  rel={computedRel}
  download={download}
  class:list={[
    'button',
    `button--${variant}`,
    `button--${size}`,
    { 'button--pill': pill },
    { 'button--disabled': disabled },
    className,
  ]}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    line-height: var(--leading-none);
    border-radius: var(--radius-md);
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
    white-space: nowrap;
    user-select: none;
    position: relative;
    overflow: hidden;
  }

  .button--pill {
    border-radius: var(--radius-full);
  }

  .button:hover {
    text-decoration: none;
  }

  /* Apple HIG & M3 Tactile Spring Micro-press */
  .button:active:not(.button--disabled) {
    transform: scale(0.975) translateY(1px);
    transition-duration: 80ms;
  }

  .button:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
    box-shadow: var(--shadow-focus);
  }

  /* Sizes */
  .button--sm {
    font-size: var(--text-xs);
    padding: var(--space-1-5) var(--space-3);
    min-height: 2rem;
  }

  .button--md {
    font-size: var(--text-sm);
    padding: var(--space-2-5) var(--space-4);
    min-height: 2.5rem;
  }

  .button--lg {
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-6);
    min-height: 3rem;
    border-radius: var(--radius-lg);
  }

  .button--lg.button--pill {
    border-radius: var(--radius-full);
  }

  /* Variants (Derived from Key Purple & M3 Tonal Palette) */
  .button--primary {
    background-color: var(--color-accent-primary);
    color: var(--color-accent-contrast);
    box-shadow: var(--shadow-sm);
  }

  .button--primary:hover:not(.button--disabled) {
    background-color: var(--color-accent-hover);
    box-shadow: var(--shadow-md);
  }

  .button--primary:active:not(.button--disabled) {
    background-color: var(--color-accent-active);
  }

  /* Secondary: Google M3 Tonal Purple Container */
  .button--secondary {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-on-container);
    border-color: var(--color-border-subtle);
  }

  .button--secondary:hover:not(.button--disabled) {
    background-color: var(--color-bg-surface-container-highest);
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  .button--outline {
    background-color: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .button--outline:hover:not(.button--disabled) {
    background-color: var(--color-bg-surface-container);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .button--ghost {
    background-color: transparent;
    color: var(--color-text-secondary);
  }

  .button--ghost:hover:not(.button--disabled) {
    background-color: var(--color-bg-surface-container);
    color: var(--color-text-primary);
  }

  .button--danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger-text);
    border-color: var(--color-danger-border);
  }

  .button--danger:hover:not(.button--disabled) {
    background-color: var(--color-danger-icon);
    color: #ffffff;
  }

  /* Disabled State */
  .button--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Button-in-Button Trailing Icon Architecture */
  .button :global(.btn-icon-wrapper) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.2);
    margin-left: var(--space-1);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .button--outline :global(.btn-icon-wrapper),
  .button--ghost :global(.btn-icon-wrapper),
  .button--secondary :global(.btn-icon-wrapper) {
    background-color: var(--color-border);
  }

  .button:hover :global(.btn-icon-wrapper) {
    transform: translateX(2px);
  }

  .button :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }
</style>
