---
import type { TagProps } from '../types';

interface Props extends TagProps {}

const {
  variant = 'default',
  size = 'md',
  href,
  interactive = Boolean(href),
  pill = true,
  iosColor,
  class: className = '',
} = Astro.props;

const TagElement = href ? 'a' : 'span';
---

<TagElement
  href={href}
  class:list={[
    'tag',
    `tag--${variant}`,
    `tag--${size}`,
    { 'tag--pill': pill },
    { 'tag--interactive': interactive },
    iosColor ? `tag--ios-${iosColor}` : undefined,
    className,
  ]}
>
  <slot />
</TagElement>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-none);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2-5);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-surface-container);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    white-space: nowrap;
  }

  .tag--pill {
    border-radius: var(--radius-full);
  }

  .tag--sm {
    font-size: 0.6875rem; /* 11px */
    padding: 0.125rem 0.375rem;
  }

  .tag--md {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2-5);
  }

  /* Variants */
  .tag--default {
    background-color: var(--color-bg-surface-container);
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }

  .tag--accent {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-primary);
    border-color: var(--color-accent-subtle);
  }

  .tag--cert {
    background-color: var(--color-bg-surface);
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    font-weight: var(--font-weight-semibold);
  }

  .tag--success {
    background-color: var(--color-success-bg);
    color: var(--color-success-text);
    border-color: var(--color-success-border);
  }

  .tag--warning {
    background-color: var(--color-warning-bg);
    color: var(--color-warning-text);
    border-color: var(--color-warning-border);
  }

  .tag--danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger-text);
    border-color: var(--color-danger-border);
  }

  .tag--outline {
    background-color: transparent;
    border-color: var(--color-border-hover);
    color: var(--color-text-secondary);
  }

  /* Native iOS Colors */
  .tag--ios-purple {
    background-color: rgba(175, 82, 222, 0.12);
    color: var(--ios-purple);
    border-color: rgba(175, 82, 222, 0.3);
  }

  .tag--ios-indigo {
    background-color: rgba(88, 86, 214, 0.12);
    color: var(--ios-indigo);
    border-color: rgba(88, 86, 214, 0.3);
  }

  .tag--ios-blue {
    background-color: rgba(0, 122, 255, 0.12);
    color: var(--ios-blue);
    border-color: rgba(0, 122, 255, 0.3);
  }

  .tag--ios-mint {
    background-color: rgba(0, 199, 190, 0.12);
    color: var(--ios-mint);
    border-color: rgba(0, 199, 190, 0.3);
  }

  .tag--ios-green {
    background-color: rgba(52, 199, 89, 0.12);
    color: var(--ios-green);
    border-color: rgba(52, 199, 89, 0.3);
  }

  .tag--ios-orange {
    background-color: rgba(255, 149, 0, 0.12);
    color: var(--ios-orange);
    border-color: rgba(255, 149, 0, 0.3);
  }

  .tag--ios-pink {
    background-color: rgba(255, 45, 85, 0.12);
    color: var(--ios-pink);
    border-color: rgba(255, 45, 85, 0.3);
  }

  /* Interactive Hover & Spring Micro-Press */
  .tag--interactive {
    cursor: pointer;
  }

  .tag--interactive:hover {
    background-color: var(--color-bg-surface-container-high);
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .tag--interactive:active {
    transform: scale(0.96);
  }
</style>
