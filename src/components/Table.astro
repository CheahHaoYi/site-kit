---
import type { TableProps } from '../types';

interface Props extends TableProps {}

const {
  headers,
  rows,
  caption,
  striped = false,
  compact = false,
  class: className = '',
} = Astro.props;

const hasData = headers && rows;
---

<div class:list={['table-container', className]}>
  <div class="table-scroll-wrapper">
    <table class:list={['table-element', { 'table--striped': striped, 'table--compact': compact }]}>
      {caption && <caption class="table-caption">{caption}</caption>}
      
      {hasData ? (
        <>
          {headers && headers.length > 0 && (
            <thead>
              <tr>
                {headers.map((header) => (
                  <th scope="col">{header}</th>
                ))}
              </tr>
            </thead>
          )}
          {rows && rows.length > 0 && (
            <tbody>
              {rows.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          )}
        </>
      ) : (
        <slot />
      )}
    </table>
  </div>
</div>

<style>
  .table-container {
    width: 100%;
    margin: var(--space-6) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-surface);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .table-scroll-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-element {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
    white-space: nowrap;
  }

  .table-caption {
    caption-side: top;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-align: left;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg-elevated);
  }

  .table-element th {
    background-color: var(--color-bg-elevated);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .table-element td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .table-element tr:last-child td {
    border-bottom: none;
  }

  .table-element tbody tr {
    transition: background-color var(--transition-fast);
  }

  .table-element tbody tr:hover {
    background-color: var(--color-bg-elevated);
    color: var(--color-text-primary);
  }

  /* Striped Rows */
  .table--striped tbody tr:nth-child(even) {
    background-color: var(--color-bg-elevated);
  }

  /* Compact Variant */
  .table--compact th,
  .table--compact td {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
  }
</style>
