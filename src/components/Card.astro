---
import type { CardProps } from '../types';
import { resolveUrl } from '../utils/url';
import Badge from './Badge.astro';
import Tag from './Tag.astro';

interface Props extends CardProps {}

const {
  title,
  description,
  href,
  tags = [],
  badge,
  badgeVariant = 'default',
  date,
  image,
  imageAlt = '',
  variant = 'default',
  pill = false,
  doubleBezel = false,
  class: className = '',
} = Astro.props;

const resolvedHref = href ? resolveUrl(href) : undefined;
const CardTag = href ? 'a' : 'div';
---

<CardTag
  href={resolvedHref}
  class:list={[
    'card',
    `card--${variant}`,
    { 'card--clickable': Boolean(href) },
    { 'card--pill': pill },
    { 'card--double-bezel': doubleBezel || variant === 'glass' },
    className,
  ]}
>
  <div class="card__inner">
    <!-- Card Image / Header Visual -->
    {image && (
      <div class="card__media">
        <img src={resolveUrl(image)} alt={imageAlt} loading="lazy" />
      </div>
    )}
    <slot name="image" />

    <div class="card__body">
      <!-- Meta / Badge / Date -->
      {(badge || date || Astro.slots.has('meta')) && (
        <div class="card__meta">
          {badge && (
            <Badge variant={badgeVariant as any} size="sm">
              {badge}
            </Badge>
          )}
          {date && <time class="card__date">{date}</time>}
          <slot name="meta" />
        </div>
      )}

      <!-- Header / Title -->
      {title && (
        <h3 class="card__title">
          <span>{title}</span>
          {href && (
            <span class="card__arrow-wrapper" aria-hidden="true">
              <svg
                class="card__arrow"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          )}
        </h3>
      )}
      <slot name="header" />

      <!-- Description / Body -->
      {description && <p class="card__description">{description}</p>}
      <slot />

      <!-- Footer / Tags -->
      {(tags.length > 0 || Astro.slots.has('footer')) && (
        <div class="card__footer">
          {tags.length > 0 && (
            <div class="card__tags">
              {tags.map((tag) => (
                <Tag size="sm" variant="default">
                  {tag}
                </Tag>
              ))}
            </div>
          )}
          <slot name="footer" />
        </div>
      )}
    </div>
  </div>
</CardTag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--color-text-primary);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .card__inner {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    border-radius: calc(var(--radius-xl) - 1px);
    overflow: hidden;
  }

  /* Double-Bezel (Doppelrand) Nested Architecture */
  .card--double-bezel {
    padding: var(--space-1);
    background-color: var(--glass-bezel-outer);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-2xl);
  }

  .card--double-bezel .card__inner {
    border-radius: calc(var(--radius-2xl) - var(--space-1));
    background-color: var(--color-bg-surface);
    box-shadow: var(--glass-rim), var(--shadow-inner);
  }

  .card--pill {
    border-radius: var(--radius-3xl);
  }

  .card--pill .card__inner {
    border-radius: calc(var(--radius-3xl) - var(--space-1));
  }

  .card--default {
    background-color: var(--color-bg-surface);
  }

  .card--elevated {
    background-color: var(--color-bg-surface);
    box-shadow: var(--shadow-md);
  }

  .card--bordered {
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border);
  }

  /* Google Material 3 Dynamic Tonal Container */
  .card--tonal {
    background-color: var(--color-bg-surface-container);
    border-color: var(--color-border-subtle);
  }

  .card--tonal .card__inner {
    background-color: var(--color-bg-surface-container);
  }

  /* Apple HIG Frosted Glass Material */
  .card--glass {
    background-color: var(--glass-bezel-outer);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-color: var(--glass-border);
  }

  .card--glass .card__inner {
    background-color: var(--glass-bg);
    box-shadow: var(--glass-rim), var(--shadow-sm);
  }

  .card--ghost {
    background-color: transparent;
    border-color: transparent;
  }

  /* Clickable Card Hover & Spring Motion */
  .card--clickable {
    cursor: pointer;
  }

  .card--clickable:hover {
    border-color: var(--color-accent-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card--clickable.card--glass:hover .card__inner {
    background-color: var(--glass-bg-elevated);
    box-shadow: var(--shadow-md), var(--glass-rim);
  }

  .card--clickable.card--tonal:hover {
    background-color: var(--color-bg-surface-container-high);
  }

  .card--clickable:active {
    transform: scale(0.985) translateY(0);
    transition-duration: 80ms;
  }

  .card--clickable:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Media / Image */
  .card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-bg-elevated);
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .card--clickable:hover .card__media img {
    transform: scale(1.03);
  }

  /* Body */
  .card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--space-6);
    gap: var(--space-3);
  }

  /* Meta */
  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .card__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Title & Arrow */
  .card__title {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .card__arrow-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-surface-container);
    flex-shrink: 0;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .card__arrow {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-primary);
    transition: transform var(--transition-fast);
  }

  .card--clickable:hover .card__arrow-wrapper {
    background-color: var(--color-accent-primary);
  }

  .card--clickable:hover .card__arrow {
    color: #ffffff;
    transform: translate(1px, -1px);
  }

  /* Description */
  .card__description {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Footer */
  .card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }
</style>
