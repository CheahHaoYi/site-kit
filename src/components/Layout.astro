---
import type { LayoutProps } from '../types';
import Breadcrumbs from './Breadcrumbs.astro';
import Nav from './Nav.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props extends LayoutProps {}

const {
  title,
  description = 'Network engineering & AI security portfolio, certification roadmaps, and technical architecture.',
  image,
  canonicalURL,
  navLinks,
  siteTitle = 'Hao Yi Cheah',
  siteSubtitle = 'Network & AI Security',
  breadcrumbs,
  showNav = true,
  showFooter = true,
  class: className = '',
} = Astro.props;

const pageTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const currentPath = Astro.url.pathname;
const siteOrigin = Astro.site?.origin || 'https://cheahhaoyi.github.io';
const canonical = canonicalURL ? String(canonicalURL) : new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = image ? (image.startsWith('http') ? image : new URL(image, siteOrigin).href) : undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Fonts: Preconnect & Load Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-Flash Theme Initialization Script (Light mode default with dark mode alternative) -->
    <script is:inline>
      (function () {
        try {
          const storageKey = 'site-kit-theme';
          const saved = localStorage.getItem(storageKey);
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            // Default to light mode explicitly as the primary design baseline
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          // Fallback if localStorage is disabled
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <slot name="head" />
  </head>

  <body>
    {showNav && (
      <Nav
        brandTitle={siteTitle}
        brandSubtitle={siteSubtitle}
        links={navLinks}
        currentPath={currentPath}
      />
    )}

    <main id="main-content" class:list={['layout-main', className]}>
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="container layout-breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )}
      <slot />
    </main>

    {showFooter && (
      <footer class="site-footer">
        <div class="container site-footer__inner">
          <div class="site-footer__brand">
            <span class="footer-telemetry-dot" aria-hidden="true"></span>
            <span class="footer-title">{siteTitle}</span>
            <span class="footer-tagline">// CISSP &bull; CCNA &bull; RHCSA &bull; AI Security</span>
          </div>
          <div class="site-footer__meta">
            <p class="footer-text">
              Light mode default with dark mode alternative powered by <code>@cheahhaoyi/site-kit</code>.
            </p>
            <p class="footer-subtext">
              &copy; {new Date().getFullYear()} Hao Yi Cheah. All rights reserved.
            </p>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>

<style>
  .layout-main {
    flex: 1 0 auto;
    width: 100%;
    padding-top: var(--space-6);
    padding-bottom: var(--space-16);
  }

  .layout-breadcrumbs {
    margin-bottom: var(--space-4);
  }

  .site-footer {
    flex-shrink: 0;
    width: 100%;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-surface);
    padding: var(--space-8) 0 var(--space-10);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .footer-telemetry-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
    display: inline-block;
  }

  .footer-title {
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .footer-tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .site-footer__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  @media (min-width: 768px) {
    .site-footer__meta {
      text-align: right;
    }
  }

  .footer-text {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .footer-text code {
    font-family: var(--font-mono);
    color: var(--color-accent-primary);
    background-color: var(--color-bg-elevated);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-sm);
  }

  .footer-subtext {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
