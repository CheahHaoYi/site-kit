---
import type { MermaidProps } from '../types';

interface Props extends MermaidProps {}

const {
  code,
  title = 'INTERACTIVE DIAGRAM',
  subtitle = 'Visual Architecture',
  class: className = '',
} = Astro.props;

const trimmedCode = code.trim();
---

<div
  class:list={['mermaid-diagram-card', className]}
  data-mermaid-source={trimmedCode}
  data-mermaid-title={title}
  data-mermaid-subtitle={subtitle}
>
  <div class="mermaid-card-header">
    <div class="mermaid-header-left">
      <span class="mermaid-status-dot" aria-hidden="true"></span>
      <span class="mermaid-header-label">{title}</span>
    </div>

    <div class="mermaid-header-right">
      {subtitle && (
        <span class="mermaid-header-meta">
          <span class="mermaid-meta-hint">{subtitle}</span>
        </span>
      )}

      <!-- Toolbar controls -->
      <div class="mermaid-toolbar" role="toolbar" aria-label="Diagram Controls">
        <button
          type="button"
          class="mermaid-tool-btn mermaid-btn-zoom-out"
          title="Zoom Out (-)"
          aria-label="Zoom out diagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>

        <button
          type="button"
          class="mermaid-tool-btn mermaid-zoom-badge"
          title="Click to Reset Zoom (100%)"
          aria-label="Reset zoom level to 100%"
        >
          <span class="zoom-value">100%</span>
        </button>

        <button
          type="button"
          class="mermaid-tool-btn mermaid-btn-zoom-in"
          title="Zoom In (+)"
          aria-label="Zoom in diagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>

        <button
          type="button"
          class="mermaid-tool-btn mermaid-btn-reset"
          title="Fit / Center Diagram"
          aria-label="Fit and center diagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
        </button>

        <button
          type="button"
          class="mermaid-tool-btn mermaid-btn-copy"
          title="Copy Mermaid Source Code"
          aria-label="Copy Mermaid source code"
        >
          <svg class="icon-copy-default" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <svg class="icon-copy-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none; color:var(--color-success-text);">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>

        <button
          type="button"
          class="mermaid-tool-btn mermaid-btn-fullscreen"
          title="Expand Fullscreen Lightbox"
          aria-label="Expand diagram to fullscreen"
        >
          <svg class="icon-expand" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="mermaid-card-canvas" tabindex="0" role="region" aria-label="Interactive Diagram Canvas">
    <div class="mermaid-stage">
      <div class="mermaid-loading-indicator">
        <span class="mermaid-spinner"></span>
        <span>Rendering diagram...</span>
      </div>
    </div>

    <div class="mermaid-gesture-hint" aria-hidden="true">
      <span>Drag to pan • Scroll to zoom • Double-click to zoom</span>
    </div>
  </div>
</div>

<style>
  .mermaid-diagram-card {
    position: relative;
    margin: var(--space-8) 0;
    background-color: var(--color-bg-surface-container-low);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md), var(--glass-rim);
    transition: border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .mermaid-diagram-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-lg), var(--glass-rim);
  }

  .mermaid-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2-5) var(--space-4);
    background-color: var(--color-code-header-bg);
    border-bottom: 1px solid var(--color-border);
    user-select: none;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .mermaid-header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mermaid-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
    box-shadow: 0 0 8px var(--color-accent-primary);
    display: inline-block;
  }

  .mermaid-header-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-primary);
    text-transform: uppercase;
  }

  .mermaid-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mermaid-header-meta {
    display: none;
  }

  @media (min-width: 640px) {
    .mermaid-header-meta {
      display: block;
    }
  }

  .mermaid-meta-hint {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
  }

  .mermaid-toolbar {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: var(--color-bg-surface);
    padding: 2px 4px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .mermaid-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .mermaid-tool-btn:hover {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-primary);
  }

  .mermaid-tool-btn:active {
    transform: scale(0.92);
  }

  .mermaid-tool-btn:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 1px;
  }

  .mermaid-zoom-badge {
    width: auto;
    min-width: 44px;
    padding: 0 6px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .mermaid-zoom-badge:hover {
    color: var(--color-accent-primary);
  }

  .mermaid-card-canvas {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(circle at center, var(--color-bg-surface-container-low) 0%, var(--color-bg-surface) 100%);
    cursor: grab;
    user-select: none;
    touch-action: none;
  }

  .mermaid-card-canvas.is-dragging {
    cursor: grabbing;
  }

  .mermaid-stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    transform-origin: center center;
    will-change: transform;
    transition: transform 50ms linear;
  }

  .mermaid-stage.is-resetting {
    transition: transform 250ms var(--ease-spring);
  }

  :global(.mermaid-stage svg) {
    max-width: none !important;
    height: auto !important;
    display: block;
    margin: 0 auto;
    filter: drop-shadow(0 4px 12px rgba(124, 58, 237, 0.08));
    pointer-events: none;
  }

  .mermaid-loading-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .mermaid-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent-primary);
    border-radius: 50%;
    animation: mermaid-spin 0.8s linear infinite;
  }

  @keyframes mermaid-spin {
    to { transform: rotate(360deg); }
  }

  .mermaid-gesture-hint {
    position: absolute;
    bottom: var(--space-3);
    left: 50%;
    transform: translateX(-50%);
    padding: 3px 12px;
    background-color: var(--glass-bg-elevated);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    pointer-events: none;
    opacity: 0.85;
    transition: opacity var(--transition-fast);
    white-space: nowrap;
  }

  .mermaid-card-canvas:hover .mermaid-gesture-hint {
    opacity: 1;
  }
</style>
